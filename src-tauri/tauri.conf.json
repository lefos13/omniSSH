{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmniSSH",
  "version": "1.0.1",
  "identifier": "com.omnissh.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "© 2026 Nevil Macwan",
    "category": "DeveloperTool",
    "shortDescription": "A modern desktop client for SSH, SFTP/SCP, and S3",
    "longDescription": "OmniSSH is a free, open-source desktop application that combines an SSH terminal, SFTP/SCP file explorer, and S3-compatible cloud storage browser into a single, fast, privacy-first tool. Built with Tauri v2, it runs natively on macOS, Windows, and Linux.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": "v1Compatible"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUzM0U3QTEzRTA3RDBCRTkKUldUcEMzM2dFM28rVS9PanY3dC9yYmtsSXNOV0tzSXFsTHMrRFZMeU40SUFnRXZ2T25iN1Z2SWIK",
      "endpoints": [
        "https://github.com/lefos13/omniSSH/releases/latest/download/latest.json"
      ]
    }
  }
}
